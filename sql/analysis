-- ==================================================
-- STEP 1: Create the final analytical table
-- ==================================================
-- Rename columns and create calculated metrics
-- for analysis and Power BI.
--
-- Revenue = Total Sales
-- Cost = Total Sales - Profit
-- Profit Margin = Profit / Revenue × 100
-- Sales Per Unit = Revenue / Quantity
-- Profit Per Unit = Profit / Quantity


CREATE TABLE [Moroccan_Ecommerce].[dbo].[Ecommerce_Analysis] (
    Order_ID VARCHAR(50),
    Revenue DECIMAL(10,2),
    Profit DECIMAL(10,2),
    Quantity INT,
    Category NVARCHAR(100),
    Sub_Category NVARCHAR(100),
    Payment_Mode NVARCHAR(100),
    Order_Date DATE,
    Customer_Name NVARCHAR(100),
    State NVARCHAR(100),
    City NVARCHAR(100),
    Cost DECIMAL(10,2),
    Profit_Margin DECIMAL(10,2),
    Sales_Per_Unit DECIMAL(10,2),
    Profit_Per_Unit DECIMAL(10,2)
);


-- ==================================================
-- STEP 2: Insert the transformed data
-- ==================================================

INSERT INTO [Moroccan_Ecommerce].[dbo].[Ecommerce_Analysis] (
    Order_ID,
    Revenue,
    Profit,
    Quantity,
    Category,
    Sub_Category,
    Payment_Mode,
    Order_Date,
    Customer_Name,
    State,
    City,
    Cost,
    Profit_Margin,
    Sales_Per_Unit,
    Profit_Per_Unit
)

SELECT
    Order_ID,

    -- Renamed columns
    Total_Sales AS Revenue,
    Profit,
    Quantity,
    Category,
    Sub_Category,
    PaymentMode AS Payment_Mode,
    Order_Date,
    CustomerName AS Customer_Name,
    State,
    City,

    -- Calculated columns
    Total_Sales - Profit AS Cost,

    CAST(
        (
            CAST(Profit AS DECIMAL(18,4))
            / NULLIF(Total_Sales, 0)
        ) * 100
        AS DECIMAL(10,2)
    ) AS Profit_Margin,

    CAST(
        Total_Sales / NULLIF(Quantity, 0)
        AS DECIMAL(10,2)
    ) AS Sales_Per_Unit,

    CAST(
        Profit / NULLIF(Quantity, 0)
        AS DECIMAL(10,2)
    ) AS Profit_Per_Unit

FROM [Moroccan_Ecommerce].[dbo].[Ecommerce_Joined];


-- ==================================================
-- STEP 3: Verify the final analytical table
-- ==================================================

SELECT *
FROM [Moroccan_Ecommerce].[dbo].[Ecommerce_Analysis];


-- ==================================================
-- STEP 4: Validate the number of records
-- ==================================================

SELECT COUNT(*) AS Analysis_Row_Count
FROM [Moroccan_Ecommerce].[dbo].[Ecommerce_Analysis];


